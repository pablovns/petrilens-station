# Java properties, sem aspas, export ou expansão de variáveis. Copie para .env na raiz.
# Preencha valores próprios; campos vazios impedem iniciar o servidor.
ESTACAO_API_KEY=
PAINEL_USUARIO=
PAINEL_SENHA=

# Somente upload de captura exige a chave privada RSA 2048 em PEM PKCS#8.
# Sugestão Linux (use caminho absoluto e o seu usuário; sem expansão de ~ ou $):
CAPTURA_CHAVE_PRIVADA=/home/SEU_USUARIO/.config/petrilens/captura-privada.pem
